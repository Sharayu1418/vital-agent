# Copy to .env for local dev. NEVER commit .env.
# GCP — local dev uses `gcloud auth application-default login`; Cloud Run uses its service identity (no key file, ever)
GOOGLE_CLOUD_PROJECT=vital-agent-dev
GOOGLE_CLOUD_LOCATION=us-east1

# Model tiering (D5): Flash by default
VITAL_MODEL=gemini-2.5-flash

# Tool provider keys (D6: these stay inside adapters)
OPENWEATHER_API_KEY=your-key-here
GOOGLE_PLACES_API_KEY=your-key-here

# Security — dev settings. In prod: DEBUG_ENDPOINTS stays false,
# API_AUTH_TOKEN comes from Secret Manager (generate: openssl rand -hex 32).
# NOTE: DEBUG_ENDPOINTS=true refuses to boot without a non-empty token.
DEBUG_ENDPOINTS=true
API_AUTH_TOKEN=dev-only-token-change-me
# Local dev runs over http, so opt OUT of the Secure cookie flag here.
# In prod this stays unset -> defaults to true (HTTPS-only cookies).
SESSION_COOKIE_SECURE=false
# Cookie scope. 'lax' (default) for same-site setups: localhost dev, or
# app.yourdomain.com + api.yourdomain.com in prod (recommended).
# Vercel <-> Cloud Run on separate sites: set 'none' (requires
# SESSION_COOKIE_SECURE=true; enables the origin-check CSRF guard).
# SESSION_COOKIE_SAMESITE=lax

# Phase 2: sandboxed analysis (key from e2b.dev — free tier is fine for dev)
E2B_API_KEY=your-key-here

# Phase 3: events (free key: developer.ticketmaster.com). Optional —
# the events tool reports 'not configured' gracefully without it.
# TICKETMASTER_API_KEY=

# Phase 4: observability — LangSmith traces every agent hop (smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=vital-dev

# Phase 4: guardrails (defaults shown; per-user daily cap)
# Usage is now billed from real provider token counts, not a chars/4
# estimate. The old estimate undercounted badly, so the effective cap was
# looser than this number implied — check `undercount_ratio` in the
# chat_turn logs before retuning it.
# DAILY_TOKEN_BUDGET=50000
# RECURSION_LIMIT=25

# NOTE: no community-search provider is configured, on purpose. Every
# third-party community API closed between 2019 and 2026. Community
# discovery runs on Google Places + the Activity Buddy Board — see
# docs/LIMITATIONS.md before wiring in another one.

# Hard ceiling on the crisis screen's model call. Past this we stop waiting
# and fall back to deterministic matching, so a slow provider can never
# leave a distressed person on a spinner.
# CRISIS_TIMEOUT_SECONDS=4.0

# Additional allowed CORS origin, as an ANCHORED regex. In practice this is
# for Vercel preview deployments, which get a fresh subdomain per branch and
# are otherwise blocked by the single FRONTEND_ORIGIN allowlist.
#
# Copy the shape from a real preview URL. Keep it as tight as possible:
# these are credentialed requests, *.vercel.app is a shared namespace, and a
# loose pattern would let someone else's project read your users' data.
# Startup refuses unanchored patterns and anything containing '.*'.
# PREVIEW_ORIGIN_REGEX=^https://vital-agent-git-[a-z0-9-]+-yourteam\.vercel\.app$


# --- Firebase Authentication (Google Sign-In) ---
# OFF locally by default; tests never need it. In prod (Cloud Run) set:
#   FIREBASE_AUTH_ENABLED=true
#   FIREBASE_PROJECT_ID=vital-agent-dev
# Verification uses Application Default Credentials (the Cloud Run service
# identity). There is NO service-account JSON key, ever.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=vital-agent-dev

# OAuth-first: when true, user-data routes reject unauthenticated callers
# with 401 instead of minting anonymous session identities. Public routes
# (/healthz, /docs, /openapi.json) stay open. FALSE locally (anonymous dev
# still works); set TRUE in production alongside FIREBASE_AUTH_ENABLED=true.
# Startup refuses to boot if AUTH_REQUIRED=true with no authenticator.
AUTH_REQUIRED=false

# --- Semantic memory (pgvector) ---
# Retrieval and dedup embed each fact. Defaults shown.
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIMS=768
# MEMORY_DEDUP_THRESHOLD=0.87   # measured; see scripts/tune_memory_threshold.py
# Messages sent to an agent per turn. The whole thread used to go every
# time, which grew cost and latency and would eventually blow the context
# window mid-conversation.
# HISTORY_LIMIT=20
